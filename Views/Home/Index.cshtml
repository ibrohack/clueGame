@{
    ViewData["Title"] = "Home";
}

@section Styles {
<style>
    .polaroid-card {
        background-color: #e5e2e1;
        padding: 8px 8px 32px 8px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.6);
        transition: transform 0.3s ease;
        border: 1px solid rgba(255,255,255,0.1);
    }
    .polaroid-card:hover {
        transform: scale(1.05) rotate(0deg) !important;
        z-index: 10;
    }
    .tilt-left  { transform: rotate(-2deg); }
    .tilt-right { transform: rotate(1.5deg); }
    .tilt-slight { transform: rotate(0.5deg); }
</style>
}

<div class="relative overflow-x-hidden" style="background-color:#131313; min-height:100vh;">

    <!-- Hero Section -->
    <main class="max-w-4xl mx-auto px-6 py-12 relative z-10">

        <section class="mb-24 text-center">
            <h1 class="font-bold mb-6 tracking-tighter uppercase opacity-90 drop-shadow-2xl headline-font"
                style="font-family:'Noto Serif',serif; font-size:clamp(5rem,12vw,9rem); color:#e9c349; line-height:1;">
                CLUE
            </h1>
            <div class="max-w-xl mx-auto mb-10">
                <div class="p-8 rounded shadow-inner relative"
                     style="background:#1c1b1b; border:1px solid rgba(64,73,67,0.3);">
                    <div class="absolute top-3 left-3 w-2 h-2 rounded-full" style="background:rgba(255,180,171,0.4);"></div>
                    <p class="text-lg italic leading-relaxed headline-font"
                       style="font-family:'Noto Serif',serif; color:#c0c9c1;">
                        "The rain won't stop, and neither will the questions. Tudor Mansion holds secrets in every shadow. Six guests, one victim, and a trail that leads straight into the abyss of the human heart."
                    </p>
                </div>
            </div>
            <a asp-controller="Game" asp-action="New"
               class="inline-block font-bold uppercase transition-all hover:scale-105 active:scale-95"
               style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.2); padding:16px 48px; letter-spacing:0.2em; border-radius:0.125rem; box-shadow:0 0 30px rgba(6,64,43,0.3); text-decoration:none;">
                Join Investigation
            </a>
        </section>

        <!-- Characters Section -->
        <section class="mb-24" id="characters-grid">
            <h2 class="text-xl font-bold mb-10 uppercase headline-font"
                style="font-family:'Noto Serif',serif; color:#e9c349; letter-spacing:0.3em; border-left:4px solid #06402b; padding-left:16px;">
                Characters
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/characters/chrysant_pyrite.png" alt="Chrysant Pyrite"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Chrysant Pyrite</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/characters/dahlia_onix.png" alt="Dahlia Onix"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Dahlia Onix</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/characters/fern_malachite.png" alt="Fern Malachite"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Fern Malachite</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/characters/gardenia_quartz.png" alt="Gardenia Quartz"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Gardenia Quartz</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/characters/hyacinth_sapphire.png" alt="Hyacinth Sapphire"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Hyacinth Sapphire</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/characters/poppy_ruby.png" alt="Poppy Ruby"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) brightness(0.9) contrast(1.1);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Poppy Ruby</p>
                </div>
            </div>
        </section>

        <!-- Weapons / Evidence Locker Section -->
        <section class="mb-24" id="weapons-grid">
            <h2 class="text-xl font-bold mb-10 uppercase headline-font"
                style="font-family:'Noto Serif',serif; color:#e9c349; letter-spacing:0.3em; border-left:4px solid #06402b; padding-left:16px;">
                Evidence Locker
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/weapons/chain_saw.png" alt="Chain Saw"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Chain Saw</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/weapons/dumbel.png" alt="Dumbbell"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Dumbbell</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/weapons/flowerpot.png" alt="Flowerpot"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Flowerpot</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/weapons/mower.png" alt="Mower"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Mower</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/weapons/plastic_bag.png" alt="Plastic Bag"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Plastic Bag</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/weapons/rat_poison.png" alt="Rat Poison"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) sepia(1) brightness(0.75) contrast(1.25);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Rat Poison</p>
                </div>
            </div>
        </section>

        <!-- Locations / Site Plans Section -->
        <section class="mb-24" id="locations-grid">
            <h2 class="text-xl font-bold mb-10 uppercase headline-font"
                style="font-family:'Noto Serif',serif; color:#e9c349; letter-spacing:0.3em; border-left:4px solid #06402b; padding-left:16px;">
                Site Plans
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/locations/basement.png" alt="Basement"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Basement</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/locations/cinema.png" alt="Cinema"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Cinema</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/locations/elevator.png" alt="Elevator"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Elevator</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/locations/garden.png" alt="Garden"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Garden</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/locations/gym.png" alt="Gym"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Gym</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/locations/helipad.png" alt="Helipad"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Helipad</p>
                </div>
                <div class="polaroid-card tilt-right w-52 h-64">
                    <img src="~/img/locations/panic_room.png" alt="Panic Room"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Panic Room</p>
                </div>
                <div class="polaroid-card tilt-left w-52 h-64">
                    <img src="~/img/locations/solarium.png" alt="Solarium"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Solarium</p>
                </div>
                <div class="polaroid-card tilt-slight w-52 h-64">
                    <img src="~/img/locations/swimming_pool.png" alt="Swimming Pool"
                         class="w-full h-44 object-cover" style="filter:grayscale(1) contrast(1.5) brightness(0.75);" />
                    <p class="mt-3 font-bold text-center" style="font-size:10px; color:rgba(0,0,0,0.4); text-transform:uppercase; letter-spacing:-0.03em;">Swimming Pool</p>
                </div>
            </div>
        </section>

    </main>
</div>
