@model clueGame.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Inspector's Ledger";
}

@section Styles {
<style>
    .custom-scrollbar::-webkit-scrollbar { width: 6px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: #131313; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #1b503a; border: 1px solid #404943; }

    .parchment-card {
        background-color: #F4ECD8;
        color: #2C2825;
        position: relative;
        border: 1px solid #C8B89C;
        box-shadow: 0 12px 24px rgba(0,0,0,0.6);
    }
    .parchment-card::before {
        content: '';
        position: absolute;
        inset: 8px;
        border: 1px solid #D8C8AC;
        pointer-events: none;
    }
</style>
}

<div class="relative overflow-x-hidden" style="background-color:#131313; min-height:calc(100vh - 64px - 100px);">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-surface-bright via-surface to-background pointer-events-none"></div>

    <main class="max-w-7xl mx-auto px-8 py-12 relative flex flex-col gap-8">

        <!-- Page Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-4">
            <div class="max-w-2xl">
                <h1 class="font-headline-xl text-headline-xl mb-2 drop-shadow-md"
                    style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e9c349;">
                    Inspector's Ledger
                </h1>
                <p class="font-body-lg text-body-lg italic" style="font-family:Manrope,sans-serif; color:#c0c9c1;">
                    "Trust no one, suspect everyone, and keep your notebook close."
                </p>
            </div>
            <a asp-controller="Game" asp-action="New"
               class="inline-block font-bold uppercase tracking-widest transition-all hover:scale-105 active:scale-95"
               style="font-family:'Noto Serif',serif; font-size:18px; border:4px solid rgba(233,195,73,0.4); padding:16px 48px; background:rgba(6,64,43,0.2); color:#e9c349; border-radius:0.25rem; box-shadow:0 0 15px rgba(233,195,73,0.3); text-decoration:none;">
                JUGAR
            </a>
        </header>

        <!-- Stats Grid -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">

            <!-- Cases Solved -->
            <div class="rounded-lg p-6 relative overflow-hidden border border-outline-variant/30 shadow-[0_8px_16px_rgba(0,0,0,0.5)] group hover:-translate-y-1 transition-transform"
                 style="background:#2a2a2a;">
                <div class="absolute top-0 right-0 p-4 opacity-10" style="color:#e9c349;">
                    <span class="material-symbols-outlined text-6xl">gavel</span>
                </div>
                <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1;">Cases Solved</p>
                <p style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e9c349; line-height:1.2;">@Model.GamesWon</p>
                <p class="mt-4 text-xs" style="color:#9cd2b5;">Across all investigations</p>
                <div class="absolute inset-x-0 top-0 h-px" style="background:linear-gradient(to right, transparent, #393939, transparent); opacity:0.5;"></div>
            </div>

            <!-- Accusation Accuracy -->
            <div class="rounded-lg p-6 relative overflow-hidden border border-outline-variant/30 shadow-[0_8px_16px_rgba(0,0,0,0.5)] group hover:-translate-y-1 transition-transform"
                 style="background:#2a2a2a;">
                <div class="absolute top-0 right-0 p-4 opacity-10" style="color:#e9c349;">
                    <span class="material-symbols-outlined text-6xl">target</span>
                </div>
                <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1;">Accusation Acc.</p>
                <p style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e9c349; line-height:1.2;">@Model.AccuracyPercent%</p>
                <div class="mt-4 w-full h-1 rounded-full overflow-hidden" style="background:#20201f;">
                    <div class="h-full" style="background:#e9c349; width:@(Model.AccuracyPercent)%;"></div>
                </div>
                <div class="absolute inset-x-0 top-0 h-px" style="background:linear-gradient(to right, transparent, #393939, transparent); opacity:0.5;"></div>
            </div>

            <!-- Games Played -->
            <div class="rounded-lg p-6 relative overflow-hidden border border-outline-variant/30 shadow-[0_8px_16px_rgba(0,0,0,0.5)] group hover:-translate-y-1 transition-transform"
                 style="background:#2a2a2a;">
                <div class="absolute top-0 right-0 p-4 opacity-10" style="color:#e9c349;">
                    <span class="material-symbols-outlined text-6xl">hourglass_empty</span>
                </div>
                <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1;">Games Played</p>
                <p style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e9c349; line-height:1.2;">@Model.GamesPlayed</p>
                <div class="mt-4 flex items-center gap-2 text-xs" style="color:#9cd2b5;">
                    <span class="material-symbols-outlined" style="font-size:16px;">trending_up</span>
                    <span>Total investigations</span>
                </div>
                <div class="absolute inset-x-0 top-0 h-px" style="background:linear-gradient(to right, transparent, #393939, transparent); opacity:0.5;"></div>
            </div>

            <!-- Games Lost -->
            <div class="rounded-lg p-6 relative overflow-hidden border border-outline-variant/30 shadow-[0_8px_16px_rgba(0,0,0,0.5)] group hover:-translate-y-1 transition-transform"
                 style="background:#2a2a2a;">
                <div class="absolute top-0 right-0 p-4 opacity-10" style="color:#e9c349;">
                    <span class="material-symbols-outlined text-6xl">search</span>
                </div>
                <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1;">Cases Failed</p>
                <p style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e9c349; line-height:1.2;">@(Model.GamesPlayed - Model.GamesWon)</p>
                <p class="mt-4 text-xs" style="color:#c0c9c1;">Better luck next time</p>
                <div class="absolute inset-x-0 top-0 h-px" style="background:linear-gradient(to right, transparent, #393939, transparent); opacity:0.5;"></div>
            </div>

        </section>

        <!-- Case History -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Parchment Case History -->
            <section class="lg:col-span-2 parchment-card p-6 overflow-hidden relative">
                <div class="absolute left-6 top-0 bottom-0 w-px" style="background:rgba(220,100,100,0.3);"></div>
                <div class="absolute inset-0 opacity-40 pointer-events-none"
                     style="background-image:linear-gradient(transparent 23px, #D8C8AC 24px); background-size:100% 24px;"></div>

                <header class="flex justify-between items-end mb-6 relative z-10 pb-2" style="border-bottom:2px solid #8C7A5D;">
                    <div>
                        <h2 style="font-family:'Noto Serif',serif; font-size:24px; font-weight:700; color:#1A1815;">The Archives</h2>
                        <p style="font-family:Manrope,sans-serif; font-size:14px; color:#5C5445; font-style:italic;">Official Case Outcomes</p>
                    </div>
                    <span class="material-symbols-outlined" style="color:#8C7A5D;">inventory_2</span>
                </header>

                <div class="overflow-x-auto relative z-10 custom-scrollbar">
                    @if (Model.History.Count == 0)
                    {
                        <p class="italic text-center py-8" style="font-family:Manrope,sans-serif; color:#5C5445;">No cases on record yet.</p>
                    }
                    else
                    {
                        <table class="w-full text-left border-collapse" style="font-family:Manrope,sans-serif;">
                            <thead>
                                <tr style="color:#5C5445; border-bottom:1px solid #C8B89C;">
                                    <th class="py-3 px-2 uppercase tracking-wider text-xs font-bold">Date</th>
                                    <th class="py-3 px-2 uppercase tracking-wider text-xs font-bold">Outcome</th>
                                    <th class="py-3 px-2 uppercase tracking-wider text-xs font-bold text-center">Suspect</th>
                                    <th class="py-3 px-2 uppercase tracking-wider text-xs font-bold text-center">Weapon</th>
                                    <th class="py-3 px-2 uppercase tracking-wider text-xs font-bold text-center">Location</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model.History)
                                {
                                    <tr class="transition-colors" style="border-bottom:1px solid rgba(216,200,172,0.5);"
                                        onmouseover="this.style.background='rgba(232,220,194,0.5)'" onmouseout="this.style.background=''">
                                        <td class="py-3 px-2 text-sm">@entry.Date</td>
                                        <td class="py-3 px-2">
                                            @if (entry.Won)
                                            {
                                                <span class="inline-flex items-center gap-1 font-bold text-sm" style="color:#1B503A;">
                                                    <span class="material-symbols-outlined" style="font-size:16px;">check_circle</span> SOLVED
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 font-bold text-sm" style="color:#690005;">
                                                    <span class="material-symbols-outlined" style="font-size:16px;">cancel</span> FAILED
                                                </span>
                                            }
                                        </td>
                                        <td class="py-3 px-2 text-center text-sm">@entry.CharacterName</td>
                                        <td class="py-3 px-2 text-center text-sm">@entry.WeaponName</td>
                                        <td class="py-3 px-2 text-center text-sm">@entry.LocationName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </section>

            <!-- Inspector Profile -->
            <section class="lg:col-span-1 flex flex-col gap-4">
                <div class="rounded-lg p-6 border border-outline-variant/30 shadow-[0_8px_16px_rgba(0,0,0,0.5)] h-full flex flex-col relative overflow-hidden"
                     style="background:#2a2a2a;">
                    <div class="absolute inset-0 pointer-events-none z-10"
                         style="background:linear-gradient(to top, #131313, rgba(42,42,42,0.8), transparent);"></div>

                    <header class="relative z-20 mb-4 flex justify-between items-start">
                        <h2 style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#e9c349;">Inspector Profile</h2>
                        <span class="material-symbols-outlined opacity-50" style="color:#e9c349;">psychology</span>
                    </header>

                    <div class="relative z-20 mt-auto">
                        <p class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#9cd2b5;">Active Detective</p>
                        <p class="uppercase leading-none mb-2" style="font-family:'Noto Serif',serif; font-size:32px; font-weight:600; color:#e5e2e1;">@Model.PlayerName</p>
                        <div class="flex items-center gap-2 flex-wrap">
                            <div class="px-2 py-1 border text-xs rounded" style="background:#20201f; border-color:#404943; color:#c0c9c1;">
                                Win Rate: @Model.AccuracyPercent%
                            </div>
                            <div class="px-2 py-1 border text-xs rounded" style="background:#20201f; border-color:#404943; color:#c0c9c1;">
                                @Model.GamesWon Solved
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>

        <!-- Footer -->
        <footer class="mt-4 text-center pt-8" style="border-top:1px solid rgba(138,147,140,0.2);">
            <p class="uppercase tracking-[0.2em] opacity-50" style="font-family:Manrope,sans-serif; font-size:12px; color:#c0c9c1;">
                © 1923 Boddy Mansion Investigations
            </p>
        </footer>

    </main>
</div>
