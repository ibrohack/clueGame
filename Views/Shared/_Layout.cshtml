<!DOCTYPE html>
<html class="dark" lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CLUE</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- Tailwind compiled CSS -->
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/clueGame.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>
<body>

    <!-- ==================== NAVBAR ==================== -->
    <header class="site-header">
        <nav class="nav-inner">

            <!-- Brand -->
            <a asp-controller="Home" asp-action="Index" class="nav-brand">CLUE</a>

            <!-- Center links (desktop) -->
            <div class="nav-center">

                <!-- Characters dropdown -->
                <div class="nav-group">
                    <button class="nav-trigger" type="button">
                        Characters
                        <span class="material-symbols-outlined nav-chevron">expand_more</span>
                    </button>
                    <div class="nav-dropdown">
                        <a href="/Characters/character_2">Chrysant Pyrite</a>
                        <a href="/Characters/character_5">Dahlia Onix</a>
                        <a href="/Characters/character_1">Fern Malachite</a>
                        <a href="/Characters/character_6">Gardenia Quartz</a>
                        <a href="/Characters/character_3">Hyacinth Sapphire</a>
                        <a href="/Characters/character_4">Poppy Ruby</a>
                    </div>
                </div>

                <!-- Weapons dropdown -->
                <div class="nav-group">
                    <button class="nav-trigger" type="button">
                        Weapons
                        <span class="material-symbols-outlined nav-chevron">expand_more</span>
                    </button>
                    <div class="nav-dropdown">
                        <a href="/Weapons/weapon_5">Chain Saw</a>
                        <a href="/Weapons/weapon_2">Dumbbell</a>
                        <a href="/Weapons/weapon_3">Flowerpot</a>
                        <a href="/Weapons/weapon_1">Mower</a>
                        <a href="/Weapons/weapon_4">Plastic Bag</a>
                        <a href="/Weapons/weapon_6">Rat Poison</a>
                    </div>
                </div>

                <!-- Locations dropdown -->
                <div class="nav-group">
                    <button class="nav-trigger" type="button">
                        Locations
                        <span class="material-symbols-outlined nav-chevron">expand_more</span>
                    </button>
                    <div class="nav-dropdown">
                        <a href="/Locations/location_4">Basement</a>
                        <a href="/Locations/location_1">Cinema</a>
                        <a href="/Locations/location_7">Elevator</a>
                        <a href="/Locations/location_6">Garden</a>
                        <a href="/Locations/location_2">Gym</a>
                        <a href="/Locations/location_8">Helipad</a>
                        <a href="/Locations/location_9">Panic Room</a>
                        <a href="/Locations/location_5">Solarium</a>
                        <a href="/Locations/location_3">Swimming Pool</a>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home" asp-action="Dashboard" class="nav-link">Dashboard</a>
                    <a asp-controller="Game" asp-action="Index" class="nav-link-green">Play Game</a>
                }
            </div>

            <!-- Right: auth links -->
            <div class="nav-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-username">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;padding:0;">
                        <button type="submit" class="nav-logout">Log Out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-link-green">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="nav-link-gold">Register</a>
                }
            </div>

            <!-- Mobile hamburger -->
            <button id="hamburger-btn" class="nav-hamburger" type="button" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </nav>

        <!-- Mobile menu -->
        <div id="mobile-menu" class="nav-mobile">
            <p class="nav-mobile-label">Characters</p>
            <div class="nav-mobile-links">
                <a href="/Characters/character_2">Chrysant Pyrite</a>
                <a href="/Characters/character_5">Dahlia Onix</a>
                <a href="/Characters/character_1">Fern Malachite</a>
                <a href="/Characters/character_6">Gardenia Quartz</a>
                <a href="/Characters/character_3">Hyacinth Sapphire</a>
                <a href="/Characters/character_4">Poppy Ruby</a>
            </div>
            <p class="nav-mobile-label">Weapons</p>
            <div class="nav-mobile-links">
                <a href="/Weapons/weapon_5">Chain Saw</a>
                <a href="/Weapons/weapon_2">Dumbbell</a>
                <a href="/Weapons/weapon_3">Flowerpot</a>
                <a href="/Weapons/weapon_1">Mower</a>
                <a href="/Weapons/weapon_4">Plastic Bag</a>
                <a href="/Weapons/weapon_6">Rat Poison</a>
            </div>
            <p class="nav-mobile-label">Locations</p>
            <div class="nav-mobile-links">
                <a href="/Locations/location_4">Basement</a>
                <a href="/Locations/location_1">Cinema</a>
                <a href="/Locations/location_7">Elevator</a>
                <a href="/Locations/location_6">Garden</a>
                <a href="/Locations/location_2">Gym</a>
                <a href="/Locations/location_8">Helipad</a>
                <a href="/Locations/location_9">Panic Room</a>
                <a href="/Locations/location_5">Solarium</a>
                <a href="/Locations/location_3">Swimming Pool</a>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <hr class="nav-mobile-divider" />
                <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Game" asp-action="Index" class="nav-link-green">Play Game</a>
                <div class="nav-mobile-auth">
                    <span class="nav-username">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                        <button type="submit" class="nav-logout">Log Out</button>
                    </form>
                </div>
            }
            else
            {
                <hr class="nav-mobile-divider" />
                <a asp-controller="Account" asp-action="Login" class="nav-link-green">Login</a>
                <a asp-controller="Account" asp-action="Register" class="nav-link-gold">Register</a>
            }
        </div>
    </header>
    <!-- ==================== END NAVBAR ==================== -->

    @RenderBody()

    <!-- ==================== FOOTER ==================== -->
    <footer class="w-full border-t"
            style="background:#0e0e0e; border-color:rgba(64,73,67,0.3); padding: 32px 0;">
        <div class="flex flex-col md:flex-row justify-between items-center px-6 gap-4 max-w-7xl mx-auto">
            <div class="flex flex-col items-center md:items-start gap-1">
                <span class="headline-font font-semibold tracking-tight" style="color:#e9c349; font-size:24px;">TUDOR ENIGMA</span>
                <p class="uppercase tracking-widest" style="color:#8a938c; font-size:11px;">© 1948 Blackwood Estate. All records classified.</p>
            </div>
            <div class="flex gap-6">
                <a asp-controller="Home" asp-action="Privacy"
                   class="underline uppercase transition-opacity opacity-70 hover:opacity-100"
                   style="color:#c0c9c1; font-size:11px; letter-spacing:0.1em;">Privacy</a>
            </div>
        </div>
    </footer>
    <!-- ==================== END FOOTER ==================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Mobile hamburger toggle
        document.getElementById('hamburger-btn').addEventListener('click', function () {
            document.getElementById('mobile-menu').classList.toggle('is-open');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
