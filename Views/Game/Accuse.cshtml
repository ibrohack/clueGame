@model clueGame.Models.ViewModels.AccuseViewModel
@{
    ViewData["Title"] = "Formal Accusation";
    Layout = "_Layout";
}

@section Styles {
<style>
    body { overflow: hidden; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .icon-fill { font-variation-settings: 'FILL' 1; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #20201f; }
    ::-webkit-scrollbar-thumb { background: #404943; border-radius: 4px; }
    .select-styled {
        background: #0e0e0e;
        border: 1px solid #404943;
        color: #e5e2e1;
        font-family: Manrope, sans-serif;
        font-size: 16px;
        padding: 10px 12px;
        width: 100%;
        border-radius: 0.25rem;
        appearance: none;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s;
    }
    .select-styled:focus { border-color: #9cd2b5; box-shadow: 0 0 0 1px #9cd2b5; }
</style>
}

<div class="flex" style="height: calc(100vh - 64px);">

    <!-- Sidebar -->
    <nav class="flex-shrink-0 flex flex-col z-40"
         style="width:256px; background:#042016; border-right:2px solid rgba(120,80,0,0.4); box-shadow: 4px 0 20px rgba(0,0,0,0.8);">

        <!-- Case file header -->
        <div class="p-6" style="border-bottom:1px solid rgba(120,80,0,0.4);">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-full flex items-center justify-center" style="background:#1a1a1a; border:1px solid #e9c349;">
                    <span class="material-symbols-outlined icon-fill" style="color:#e9c349;">local_police</span>
                </div>
                <div>
                    <p class="font-bold tracking-widest text-xs uppercase" style="color:#e9c349;">Current Case</p>
                    <p class="capitalize" style="font-family:Manrope,sans-serif; font-size:10px; color:rgba(209,250,229,0.5);">The Blackwood Murder</p>
                </div>
            </div>
        </div>

        <!-- Navigation -->
        <div class="flex-1 flex flex-col py-2">
            <a asp-action="Board" asp-route-gameId="@Model.GameId"
               class="flex items-center gap-3 px-6 py-4 transition-all"
               style="color:rgba(209,250,229,0.7); font-family:'Noto Serif',serif; font-size:12px; text-transform:uppercase; letter-spacing:0.1em; text-decoration:none;"
               onmouseover="this.style.background='rgba(6,64,43,0.5)'; this.style.color='white'; this.style.transform='translateX(4px)';"
               onmouseout="this.style.background=''; this.style.color='rgba(209,250,229,0.7)'; this.style.transform='';">
                <span class="material-symbols-outlined" style="font-size:18px;">map</span>
                Detective Ledger
            </a>
            <a href="#"
               class="flex items-center gap-3 px-6 py-4 transition-all"
               style="color:rgba(209,250,229,0.7); font-family:'Noto Serif',serif; font-size:12px; text-transform:uppercase; letter-spacing:0.1em; text-decoration:none;"
               onmouseover="this.style.background='rgba(6,64,43,0.5)'; this.style.color='white';"
               onmouseout="this.style.background=''; this.style.color='rgba(209,250,229,0.7)';">
                <span class="material-symbols-outlined" style="font-size:18px;">inventory_2</span>
                Evidence Bag
            </a>
            <a href="#"
               class="flex items-center gap-3 px-6 py-4 transition-all"
               style="color:rgba(209,250,229,0.7); font-family:'Noto Serif',serif; font-size:12px; text-transform:uppercase; letter-spacing:0.1em; text-decoration:none;"
               onmouseover="this.style.background='rgba(6,64,43,0.5)'; this.style.color='white';"
               onmouseout="this.style.background=''; this.style.color='rgba(209,250,229,0.7)';">
                <span class="material-symbols-outlined" style="font-size:18px;">vpn_key</span>
                Secret Passages
            </a>
        </div>

        <!-- Make Accusation CTA (active) -->
        <div class="p-6" style="border-top:1px solid rgba(120,80,0,0.4);">
            <div class="flex items-center gap-3 px-4 py-3 rounded font-bold text-sm uppercase tracking-widest"
                 style="background:#e9c349; color:#1a1000;">
                <span class="material-symbols-outlined icon-fill" style="font-size:18px;">gavel</span>
                Make Accusation
            </div>
        </div>

    </nav>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto" style="background:#0e0e0e;">

        <!-- Ambient gradient -->
        <div class="pointer-events-none absolute inset-0"
             style="background:radial-gradient(ellipse at top, rgba(42,42,42,0.2), transparent, transparent); z-index:0;"></div>

        <div class="relative z-10 px-8 py-12 max-w-5xl mx-auto">

            <!-- Page Header -->
            <div class="text-center flex flex-col items-center mb-10">
                <div class="w-16 h-16 rounded-full flex items-center justify-center mb-4"
                     style="background:rgba(175,141,17,0.2); border:2px solid rgba(233,195,73,0.5); box-shadow:0 0 20px rgba(233,195,73,0.15);">
                    <span class="material-symbols-outlined icon-fill" style="color:#e9c349; font-size:32px;">gavel</span>
                </div>
                <h2 style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; color:#e5e2e1; letter-spacing:-0.02em; line-height:1.2; margin-bottom:8px;">
                    Formal Accusation
                </h2>
                <p style="font-family:Manrope,sans-serif; font-size:18px; color:#c0c9c1; max-width:560px; line-height:1.6;">
                    Assemble your final theory. Be certain — once an accusation is made, it cannot be unsaid.
                </p>
            </div>

            <!-- Validation Summary -->
            <div asp-validation-summary="All"
                 class="mb-6 px-4 py-3 rounded text-xs"
                 style="background:rgba(147,0,10,0.2); border:1px solid rgba(255,180,171,0.3); color:#ffb4ab;"></div>

            <form asp-action="Accuse" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="GameId" />

                <!-- Bento grid: 3 columns -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">

                    <!-- Suspect -->
                    <section class="rounded-xl p-6 flex flex-col shadow-xl relative overflow-hidden"
                             style="background:#20201f; border:1px solid #404943;">
                        <div class="absolute top-0 left-0 w-full h-32 pointer-events-none"
                             style="background:linear-gradient(to bottom, rgba(6,64,43,0.2), transparent);"></div>
                        <div class="flex justify-between items-center mb-6 relative z-10">
                            <h3 style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#9cd2b5;">The Suspect</h3>
                            <span class="material-symbols-outlined" style="color:#8a938c;">person_search</span>
                        </div>
                        <div class="flex-1 flex flex-col p-4 rounded-lg relative"
                             style="background:#131313; border:2px solid #e9c349; box-shadow:0 4px 15px rgba(0,0,0,0.5);">
                            <p class="uppercase tracking-widest mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#c0c9c1;">Select Suspect</p>
                            <select asp-for="CharacterId" class="select-styled">
                                @foreach (var c in Model.Characters)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                            <div class="mt-4 text-center">
                                <span class="inline-block px-2 py-1 text-xs uppercase font-bold rounded"
                                      style="border:1px solid rgba(233,195,73,0.3); color:#e9c349; background:rgba(233,195,73,0.1); letter-spacing:0.1em; font-family:Manrope,sans-serif;">
                                    Selected
                                </span>
                            </div>
                        </div>
                    </section>

                    <!-- Weapon -->
                    <section class="rounded-xl p-6 flex flex-col shadow-xl relative overflow-hidden"
                             style="background:#20201f; border:1px solid #404943;">
                        <div class="absolute top-0 left-0 w-full h-32 pointer-events-none"
                             style="background:linear-gradient(to bottom, rgba(103,30,27,0.1), transparent);"></div>
                        <div class="flex justify-between items-center mb-6 relative z-10">
                            <h3 style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#ffb3ac;">The Weapon</h3>
                            <span class="material-symbols-outlined" style="color:#8a938c;">hardware</span>
                        </div>
                        <div class="flex-1 flex flex-col p-4 rounded-lg relative"
                             style="background:#131313; border:2px solid #e9c349; box-shadow:0 4px 15px rgba(0,0,0,0.5);">
                            <p class="uppercase tracking-widest mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#c0c9c1;">Select Weapon</p>
                            <select asp-for="WeaponId" class="select-styled">
                                @foreach (var w in Model.Weapons)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                            <div class="mt-4 text-center">
                                <span class="inline-block px-2 py-1 text-xs uppercase font-bold rounded"
                                      style="border:1px solid rgba(233,195,73,0.3); color:#e9c349; background:rgba(233,195,73,0.1); letter-spacing:0.1em; font-family:Manrope,sans-serif;">
                                    Selected
                                </span>
                            </div>
                        </div>
                    </section>

                    <!-- Location -->
                    <section class="rounded-xl p-6 flex flex-col shadow-xl relative overflow-hidden"
                             style="background:#20201f; border:1px solid #404943;">
                        <div class="absolute top-0 left-0 w-full h-32 pointer-events-none"
                             style="background:linear-gradient(to bottom, rgba(175,141,17,0.1), transparent);"></div>
                        <div class="flex justify-between items-center mb-6 relative z-10">
                            <h3 style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#e9c349;">The Location</h3>
                            <span class="material-symbols-outlined" style="color:#8a938c;">meeting_room</span>
                        </div>
                        <div class="flex-1 flex flex-col p-4 rounded-lg relative"
                             style="background:#131313; border:2px solid #e9c349; box-shadow:0 4px 15px rgba(0,0,0,0.5);">
                            <p class="uppercase tracking-widest mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#c0c9c1;">Select Location</p>
                            <select asp-for="LocationId" class="select-styled">
                                @foreach (var l in Model.Locations)
                                {
                                    <option value="@l.Id">@l.Name</option>
                                }
                            </select>
                            <div class="mt-4 text-center">
                                <span class="inline-block px-2 py-1 text-xs uppercase font-bold rounded"
                                      style="border:1px solid rgba(233,195,73,0.3); color:#e9c349; background:rgba(233,195,73,0.1); letter-spacing:0.1em; font-family:Manrope,sans-serif;">
                                    Selected
                                </span>
                            </div>
                        </div>
                    </section>

                </div>

                <!-- Warning Panel -->
                <div class="flex items-center gap-4 px-6 py-4 rounded-lg mb-8 mx-auto"
                     style="max-width:520px; background:rgba(147,0,10,0.1); border:1px solid rgba(255,180,171,0.5); backdrop-filter:blur(4px); box-shadow:0 0 20px rgba(255,180,171,0.05);">
                    <span class="material-symbols-outlined icon-fill" style="color:#ffb4ab; font-size:28px;">warning</span>
                    <div>
                        <h4 class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#ffb4ab;">Critical Warning</h4>
                        <p style="font-family:Manrope,sans-serif; font-size:16px; color:#ffdad6; line-height:1.6;">
                            If you are wrong, you lose the game and can no longer make suggestions.
                        </p>
                    </div>
                </div>

                <!-- CTA Button -->
                <div class="flex justify-center pb-12">
                    <button type="submit"
                            onclick="return confirm('Are you sure? A wrong accusation ends the game.')"
                            class="relative group cursor-pointer active:scale-[0.98] transition-transform">
                        <!-- Glow -->
                        <div class="absolute -inset-1 rounded-full blur opacity-40 group-hover:opacity-70 transition duration-500"
                             style="background:linear-gradient(to right, #af8d11, #e9c349, #af8d11);"></div>
                        <!-- Button -->
                        <div class="relative flex items-center gap-4 px-16 py-6 rounded-full overflow-hidden"
                             style="background:#0e0e0e; border:2px solid #e9c349;">
                            <div class="absolute inset-0 pointer-events-none"
                                 style="background:linear-gradient(to top, transparent, rgba(233,195,73,0.1));"></div>
                            <span class="material-symbols-outlined z-10" style="color:#e9c349; font-size:32px;">campaign</span>
                            <span class="z-10" style="font-family:'Noto Serif',serif; font-size:32px; font-weight:600; color:#e9c349; letter-spacing:0.05em;">MAKE ACCUSATION</span>
                        </div>
                    </button>
                </div>

            </form>
        </div>
    </main>

</div>
