@{
    ViewData["Title"] = "Home";
}

@section Styles {
<style>
    /* ── Polaroid card ── */
    .polaroid-card {
        background-color: #e5e2e1;
        padding: 8px 8px 28px 8px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.65);
        border: 1px solid rgba(255,255,255,0.12);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: block;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }
    .polaroid-card::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0);
        transition: background 0.2s ease;
        pointer-events: none;
    }
    .polaroid-card:hover::after { background: rgba(0,0,0,0.06); }
    .polaroid-card:hover {
        transform: scale(1.06) rotate(0deg) !important;
        z-index: 10;
        box-shadow: 0 24px 48px -6px rgba(0,0,0,0.85);
    }
    .polaroid-card img {
        display: block;
        width: 100%;
        height: auto;   /* natural aspect ratio — no cropping */
    }
    .polaroid-card .caption {
        margin-top: 8px;
        text-align: center;
        font-family: Manrope, sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: rgba(0,0,0,0.42);
    }

    /* Tilt helpers */
    .tilt-left   { transform: rotate(-2deg); }
    .tilt-right  { transform: rotate(1.5deg); }
    .tilt-slight { transform: rotate(0.5deg); }

    /* Section heading */
    .section-heading {
        font-family: 'Noto Serif', serif;
        font-size: 20px;
        font-weight: 700;
        color: #e9c349;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        border-left: 4px solid #06402b;
        padding-left: 16px;
        margin-bottom: 36px;
    }

    /* Divider between sections */
    .section-divider {
        border: none;
        border-top: 1px solid rgba(64,73,67,0.25);
        margin: 0 0 64px 0;
    }
</style>
}

<div class="relative overflow-x-hidden" style="background-color:#131313; min-height:100vh;">

    <main class="max-w-4xl mx-auto px-6 py-12 relative z-10">

        <!-- ── Hero ── -->
        <section class="mb-24 text-center">
            <h1 class="font-bold mb-6 uppercase drop-shadow-2xl"
                style="font-family:'Noto Serif',serif; font-size:clamp(5rem,12vw,9rem); color:#e9c349; line-height:1; letter-spacing:-0.02em;">
                CLUE
            </h1>
            <div class="max-w-xl mx-auto mb-10">
                <div class="p-8 rounded shadow-inner relative"
                     style="background:#1c1b1b; border:1px solid rgba(64,73,67,0.3);">
                    <div class="absolute top-3 left-3 w-2 h-2 rounded-full" style="background:rgba(255,180,171,0.4);"></div>
                    <p class="text-lg italic leading-relaxed"
                       style="font-family:'Noto Serif',serif; color:#c0c9c1;">
                        "The rain won't stop, and neither will the questions. Tudor Mansion holds secrets in every shadow. Six guests, one victim, and a trail that leads straight into the abyss of the human heart."
                    </p>
                </div>
            </div>
            <a asp-controller="Game" asp-action="New"
               class="inline-block font-bold uppercase transition-all hover:scale-105 active:scale-95"
               style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.2); padding:16px 48px; letter-spacing:0.2em; border-radius:0.125rem; box-shadow:0 0 30px rgba(6,64,43,0.3); text-decoration:none;">
                Join Investigation
            </a>
        </section>

        <hr class="section-divider" />

        <!-- ── Characters ── -->
        <section class="mb-24" id="characters-grid">
            <h2 class="section-heading">Characters</h2>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">

                <a href="/Characters/character_2" class="polaroid-card tilt-left w-48">
                    <img src="~/img/characters/chrysant_pyrite.png" alt="Chrysant Pyrite"
                          />
                    <p class="caption">Chrysant Pyrite</p>
                </a>

                <a href="/Characters/character_5" class="polaroid-card tilt-right w-48">
                    <img src="~/img/characters/dahlia_onix.png" alt="Dahlia Onix"
                          />
                    <p class="caption">Dahlia Onix</p>
                </a>

                <a href="/Characters/character_1" class="polaroid-card tilt-slight w-48">
                    <img src="~/img/characters/fern_malachite.png" alt="Fern Malachite"
                          />
                    <p class="caption">Fern Malachite</p>
                </a>

                <a href="/Characters/character_6" class="polaroid-card tilt-right w-48">
                    <img src="~/img/characters/gardenia_quartz.png" alt="Gardenia Quartz"
                          />
                    <p class="caption">Gardenia Quartz</p>
                </a>

                <a href="/Characters/character_3" class="polaroid-card tilt-left w-48">
                    <img src="~/img/characters/hyacinth_sapphire.png" alt="Hyacinth Sapphire"
                          />
                    <p class="caption">Hyacinth Sapphire</p>
                </a>

                <a href="/Characters/character_4" class="polaroid-card tilt-slight w-48">
                    <img src="~/img/characters/poppy_ruby.png" alt="Poppy Ruby"
                          />
                    <p class="caption">Poppy Ruby</p>
                </a>

            </div>
        </section>

        <hr class="section-divider" />

        <!-- ── Evidence Locker (Weapons) ── -->
        <section class="mb-24" id="weapons-grid">
            <h2 class="section-heading">Evidence Locker</h2>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">

                <a href="/Weapons/weapon_5" class="polaroid-card tilt-right w-48">
                    <img src="~/img/weapons/chain_saw.png" alt="Chain Saw"
                          />
                    <p class="caption">Chain Saw</p>
                </a>

                <a href="/Weapons/weapon_2" class="polaroid-card tilt-left w-48">
                    <img src="~/img/weapons/dumbel.png" alt="Dumbbell"
                          />
                    <p class="caption">Dumbbell</p>
                </a>

                <a href="/Weapons/weapon_3" class="polaroid-card tilt-slight w-48">
                    <img src="~/img/weapons/flowerpot.png" alt="Flowerpot"
                          />
                    <p class="caption">Flowerpot</p>
                </a>

                <a href="/Weapons/weapon_1" class="polaroid-card tilt-left w-48">
                    <img src="~/img/weapons/mower.png" alt="Mower"
                          />
                    <p class="caption">Mower</p>
                </a>

                <a href="/Weapons/weapon_4" class="polaroid-card tilt-right w-48">
                    <img src="~/img/weapons/plastic_bag.png" alt="Plastic Bag"
                          />
                    <p class="caption">Plastic Bag</p>
                </a>

                <a href="/Weapons/weapon_6" class="polaroid-card tilt-slight w-48">
                    <img src="~/img/weapons/rat_poison.png" alt="Rat Poison"
                          />
                    <p class="caption">Rat Poison</p>
                </a>

            </div>
        </section>

        <hr class="section-divider" />

        <!-- ── Site Plans (Locations) ── -->
        <section class="mb-24" id="locations-grid">
            <h2 class="section-heading">Site Plans</h2>

            <!--
                Location images are ~232×205 px (1.13:1 landscape).
                Cards are wider (w-52) to better fill the columns at this ratio.
            -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-10 justify-items-center">

                <a href="/Locations/location_4" class="polaroid-card tilt-slight w-52">
                    <img src="~/img/locations/basement.png" alt="Basement"
                          />
                    <p class="caption">Basement</p>
                </a>

                <a href="/Locations/location_1" class="polaroid-card tilt-right w-52">
                    <img src="~/img/locations/cinema.png" alt="Cinema"
                          />
                    <p class="caption">Cinema</p>
                </a>

                <a href="/Locations/location_7" class="polaroid-card tilt-left w-52">
                    <img src="~/img/locations/elevator.png" alt="Elevator"
                          />
                    <p class="caption">Elevator</p>
                </a>

                <a href="/Locations/location_6" class="polaroid-card tilt-left w-52">
                    <img src="~/img/locations/garden.png" alt="Garden"
                          />
                    <p class="caption">Garden</p>
                </a>

                <a href="/Locations/location_2" class="polaroid-card tilt-slight w-52">
                    <img src="~/img/locations/gym.png" alt="Gym"
                          />
                    <p class="caption">Gym</p>
                </a>

                <a href="/Locations/location_8" class="polaroid-card tilt-right w-52">
                    <img src="~/img/locations/helipad.png" alt="Helipad"
                          />
                    <p class="caption">Helipad</p>
                </a>

                <a href="/Locations/location_9" class="polaroid-card tilt-right w-52">
                    <img src="~/img/locations/panic_room.png" alt="Panic Room"
                          />
                    <p class="caption">Panic Room</p>
                </a>

                <a href="/Locations/location_5" class="polaroid-card tilt-left w-52">
                    <img src="~/img/locations/solarium.png" alt="Solarium"
                          />
                    <p class="caption">Solarium</p>
                </a>

                <a href="/Locations/location_3" class="polaroid-card tilt-slight w-52">
                    <img src="~/img/locations/swimming_pool.png" alt="Swimming Pool"
                          />
                    <p class="caption">Swimming Pool</p>
                </a>

            </div>
        </section>

    </main>
</div>
