@model clueGame.Models.ViewModels.BoardViewModel
@{
    ViewData["Title"] = "Detective's Ledger";
    var game = Model.Game;
    var human = Model.HumanPlayer;
    var isHumanTurn = game.TurnPhase == "human_suggestion";
    var isHumanDone = game.TurnPhase == "human_done";
    var isBotTurns  = game.TurnPhase == "bot_turns";

    var matrix = Model.BuildMatrix();

    string RowBg(string s) => s switch
    {
        "in_hand"   => "background:rgba(6,64,43,0.3)",
        "discarded" => "background:rgba(64,73,67,0.2)",
        "suspect"   => "background:rgba(233,195,73,0.08)",
        _           => ""
    };

    string CellIcon(string s) => s switch
    {
        "has_it"      => "check",
        "no_has_it"   => "close",
        "suspect_has" => "help",
        "suspect_no"  => "do_not_disturb_on",
        _             => ""
    };

    string CellColor(string s) => s switch
    {
        "has_it"      => "#9cd2b5",
        "no_has_it"   => "#ffb4ab",
        "suspect_has" => "rgba(156,210,181,0.6)",
        "suspect_no"  => "rgba(255,180,171,0.6)",
        _             => ""
    };
}

@section Styles {
<style>
    body { overflow: hidden; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .icon-fill { font-variation-settings: 'FILL' 1; }

    .ledger-texture {
        background-image: radial-gradient(#ffffff05 1px, transparent 1px);
        background-size: 24px 24px;
    }
    .metallic-text {
        background: linear-gradient(135deg, #e9c349 0%, #af8d11 50%, #e9c349 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* ── Cell pill selects (matrix table) ── */
    .cell-pill {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        border-radius: 3px;
        border: 1px solid rgba(64,73,67,0.35);
        background: rgba(14,14,14,0.6);
        padding: 4px 4px 4px 8px;
        min-width: 62px;
        transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
    }
    .cell-pill:focus-within {
        border-color: rgba(233,195,73,0.6);
        box-shadow: 0 0 0 1px rgba(233,195,73,0.12);
    }
    .cell-select {
        appearance: none;
        -webkit-appearance: none;
        background: transparent;
        border: none;
        color: #8a938c;
        font-family: Manrope, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        outline: none;
        padding: 0;
        flex: 1;
    }
    .pill-chevron {
        font-size: 13px;
        color: rgba(64,73,67,0.7);
        pointer-events: none;
        flex-shrink: 0;
        line-height: 1;
    }
    .pill-icon {
        font-size: 13px;
        flex-shrink: 0;
        line-height: 1;
    }

    /* "Me" column status themes */
    .cell-pill[data-status="suspect"]   { border-color: rgba(233,195,73,0.45); background: rgba(233,195,73,0.07); }
    .cell-pill[data-status="suspect"]   .cell-select { color: #e9c349; }
    .cell-pill[data-status="discarded"] { border-color: rgba(156,210,181,0.45); background: rgba(156,210,181,0.08); }
    .cell-pill[data-status="discarded"] .cell-select { color: #9cd2b5; }

    /* Bot column status themes */
    .cell-pill[data-status="has_it"]      { border-color: rgba(156,210,181,0.6);  background: rgba(156,210,181,0.12); }
    .cell-pill[data-status="has_it"]      .cell-select { color: #9cd2b5; }
    .cell-pill[data-status="no_has_it"]   { border-color: rgba(255,180,171,0.6);  background: rgba(255,180,171,0.12); }
    .cell-pill[data-status="no_has_it"]   .cell-select { color: #ffb4ab; }
    .cell-pill[data-status="suspect_has"] { border-color: rgba(156,210,181,0.3);  background: rgba(156,210,181,0.06); }
    .cell-pill[data-status="suspect_has"] .cell-select { color: rgba(156,210,181,0.65); }
    .cell-pill[data-status="suspect_no"]  { border-color: rgba(255,180,171,0.3);  background: rgba(255,180,171,0.06); }
    .cell-pill[data-status="suspect_no"]  .cell-select { color: rgba(255,180,171,0.65); }

    /* ── Suggestion form selects ── */
    .select-field-wrap { position: relative; }
    .select-field {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        background: #0a0a0a;
        border: 1px solid #404943;
        border-bottom: 2px solid rgba(64,73,67,0.9);
        color: #e5e2e1;
        font-family: Manrope, sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.04em;
        padding: 13px 40px 13px 14px;
        border-radius: 3px;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .select-field:hover  { border-color: rgba(156,210,181,0.4); }
    .select-field:focus  {
        border-color: #9cd2b5;
        box-shadow: 0 0 0 1px rgba(156,210,181,0.2), 0 4px 12px rgba(0,0,0,0.4);
    }
    .select-field-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: #9cd2b5;
        pointer-events: none;
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #131313; }
    ::-webkit-scrollbar-thumb { background: #1b503a; border: 1px solid #404943; }
</style>
}

<div class="flex" style="height: calc(100vh - 64px);">

    @await Html.PartialAsync("_GameSidebar", new clueGame.Models.ViewModels.GameSidebarViewModel
    {
        GameId        = game.Id,
        ActiveSection = "ledger",
        CharacterName = Model.Characters.FirstOrDefault(c => c.Id == human.CharacterId)?.Name ?? string.Empty
    })

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto ledger-texture" style="background:#131313;">
        <div class="max-w-6xl mx-auto px-8 py-8">

            <!-- Header -->
            <div class="flex justify-between items-end mb-8">
                <div>
                    <h1 class="metallic-text uppercase tracking-tight"
                        style="font-family:'Noto Serif',serif; font-size:48px; font-weight:700; line-height:1.2; letter-spacing:-0.02em;">
                        The Detective's Ledger
                    </h1>
                    <p class="italic mt-2" style="font-family:Manrope,sans-serif; font-size:18px; color:#c0c9c1; max-width:560px; line-height:1.6;">
                        "Eliminate the impossible, and whatever remains, however improbable, must be the truth."
                    </p>
                </div>
                <!-- Phase badge -->
                <div class="flex-shrink-0 px-4 py-2 rounded text-center"
                     style="border:1px solid #404943; background:#20201f; min-width:140px;">
                    <p class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:10px; color:#8a938c;">Phase</p>
                    <p class="font-bold uppercase" style="font-family:Manrope,sans-serif; font-size:12px; color:#e9c349;">@game.TurnPhase.Replace("_", " ")</p>
                </div>
            </div>

            @* ── Suggestion result ── *@
            @if (Model.LastSuggestionResult is { } sr)
            {
                <div class="mb-6 p-4 rounded-lg" style="background:#1c1b1b; border:1px solid rgba(156,210,181,0.3);">
                    <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#9cd2b5;">Your Suggestion Result</p>
                    <p style="font-family:Manrope,sans-serif; font-size:16px; color:#e5e2e1;">
                        <span style="color:#c0c9c1;">Suggested:</span>
                        <strong>@sr.CharacterName</strong> with <strong>@sr.WeaponName</strong> at <strong>@sr.LocationName</strong>
                    </p>
                    @if (sr.NoOneRefuted)
                    {
                        <p class="mt-2 italic" style="color:#e9c349; font-family:Manrope,sans-serif; font-size:14px;">Nobody could refute your suggestion.</p>
                    }
                    else
                    {
                        <p class="mt-2" style="font-family:Manrope,sans-serif; font-size:14px; color:#c0c9c1;">
                            <strong style="color:#9cd2b5;">@sr.RefutedByName</strong> showed you: <strong style="color:#e9c349;">@sr.ShownCardName</strong>
                        </p>
                    }
                </div>
            }

            @* ── Bot turn summary ── *@
            @if (Model.CurrentBotTurn is { } bt)
            {
                <div class="mb-6 p-4 rounded-lg" style="background:#1c1b1b; border:1px solid rgba(255,180,171,0.2);">
                    <p class="uppercase tracking-widest mb-2" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#ffb3ac;">@bt.BotName's Turn</p>
                    @if (!string.IsNullOrEmpty(bt.CharacterName))
                    {
                        <p style="font-family:Manrope,sans-serif; font-size:16px; color:#e5e2e1;">
                            Suggested <strong>@bt.CharacterName</strong> with <strong>@bt.WeaponName</strong> at <strong>@bt.LocationName</strong>.
                        </p>
                    }
                    @if (bt.NoOneRefuted)
                    {
                        <p class="mt-1 italic" style="font-family:Manrope,sans-serif; font-size:14px; color:#c0c9c1;">Nobody refuted.</p>
                    }
                    else
                    {
                        <p class="mt-1" style="font-family:Manrope,sans-serif; font-size:14px; color:#c0c9c1;">
                            Refuted by <strong style="color:#9cd2b5;">@bt.RefutedByName</strong>.
                            @if (!string.IsNullOrEmpty(bt.ShownCardName))
                            {
                                <span> Showed: <strong style="color:#e9c349;">@bt.ShownCardName</strong>.</span>
                            }
                        </p>
                    }
                </div>
            }

            @* ── Action buttons ── *@
            <div class="flex flex-wrap gap-3 mb-8">
                @if (isHumanDone)
                {
                    <form asp-action="EndTurn" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="gameId" value="@game.Id" />
                        <button type="submit"
                                class="flex items-center gap-2 px-6 py-3 font-bold text-xs uppercase tracking-widest transition-all active:scale-95"
                                style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.4); font-family:Manrope,sans-serif; border-radius:0.125rem; cursor:pointer;"
                                onmouseover="this.style.background='rgba(6,64,43,0.8)';"
                                onmouseout="this.style.background='#06402b';">
                            <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span>
                            End Turn
                        </button>
                    </form>
                }

                @if (isBotTurns)
                {
                    <form asp-action="NextBot" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="gameId" value="@game.Id" />
                        <input type="hidden" name="botIndex" value="@game.PendingBotIndex" />
                        <button type="submit"
                                class="flex items-center gap-2 px-6 py-3 font-bold text-xs uppercase tracking-widest transition-all active:scale-95"
                                style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.4); font-family:Manrope,sans-serif; border-radius:0.125rem; cursor:pointer;"
                                onmouseover="this.style.background='rgba(6,64,43,0.8)';"
                                onmouseout="this.style.background='#06402b';">
                            <span class="material-symbols-outlined" style="font-size:16px;">skip_next</span>
                            Next Bot Turn
                        </button>
                    </form>
                }
            </div>

            @* ── Detective Sheet Table ── *@
            <div class="relative p-6 shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
                 style="background:#1c1b1b; border:1px solid #404943; margin-bottom:32px;">
                <!-- Corner ornaments -->
                <div class="absolute top-0 left-0 w-8 h-8" style="border-top:2px solid rgba(233,195,73,0.5); border-left:2px solid rgba(233,195,73,0.5);"></div>
                <div class="absolute top-0 right-0 w-8 h-8" style="border-top:2px solid rgba(233,195,73,0.5); border-right:2px solid rgba(233,195,73,0.5);"></div>
                <div class="absolute bottom-0 left-0 w-8 h-8" style="border-bottom:2px solid rgba(233,195,73,0.5); border-left:2px solid rgba(233,195,73,0.5);"></div>
                <div class="absolute bottom-0 right-0 w-8 h-8" style="border-bottom:2px solid rgba(233,195,73,0.5); border-right:2px solid rgba(233,195,73,0.5);"></div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr style="border-bottom:2px solid #404943;">
                                <th class="py-4 px-4" style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#e9c349; border-right:1px solid #404943; width:200px;">
                                    Card
                                </th>
                                <th class="py-4 px-3 text-center" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1; border-right:1px solid rgba(64,73,67,0.3); min-width:80px;">
                                    Me
                                </th>
                                @foreach (var botName in matrix.BotNames)
                                {
                                    <th class="py-4 px-3 text-center" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.1em; color:#c0c9c1; border-right:1px solid rgba(64,73,67,0.3); min-width:80px;">
                                        @botName
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>

                            @* Suspects *@
                            <tr style="background:rgba(6,64,43,0.2);">
                                <td colspan="@(2 + matrix.BotPlayerIds.Count)" class="py-2 px-4"
                                    style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.2em; color:#9cd2b5; text-transform:uppercase; border-bottom:1px solid rgba(64,73,67,0.5);">
                                    Suspects
                                </td>
                            </tr>
                            @foreach (var row in matrix.CharacterRows)
                            {
                                <tr class="transition-colors" style="border-bottom:1px solid rgba(64,73,67,0.2); @RowBg(row.RowStatus)"
                                    onmouseover="this.style.background='rgba(32,32,31,1)'" onmouseout="this.style.background=''">
                                    <td class="py-3 px-4" style="font-family:Manrope,sans-serif; font-size:16px; color:#e5e2e1; border-right:1px solid rgba(64,73,67,0.3);">
                                        <strong>@row.CardName</strong>
                                    </td>
                                    <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                        @if (row.RowStatus == "in_hand")
                                        {
                                            <span class="text-xs font-bold uppercase tracking-widest" style="color:#9cd2b5; font-family:Manrope,sans-serif;">MY CARD</span>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleCardStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <div class="cell-pill" data-status="@row.RowStatus">
                                                    <select name="status" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                                        <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">Maybe</option>
                                                        <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">Seen</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        }
                                    </td>
                                    @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                                    {
                                        var botId = matrix.BotPlayerIds[bi];
                                        var cell  = row.BotCells.ElementAtOrDefault(bi);
                                        var cs    = cell?.CellStatus ?? "normal";
                                        <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                            <form asp-action="ToggleCellStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <input type="hidden" name="botPlayerId" value="@botId" />
                                                <div class="cell-pill" data-status="@cs">
                                                    @if (!string.IsNullOrEmpty(CellIcon(cs)))
                                                    {
                                                        <span class="material-symbols-outlined pill-icon" style="color:@CellColor(cs);">@CellIcon(cs)</span>
                                                    }
                                                    <select name="cellStatus" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                                        <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">Has</option>
                                                        <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">No</option>
                                                        <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">~Has</option>
                                                        <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">~No</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }

                            @* Weapons *@
                            <tr style="background:rgba(103,30,27,0.1);">
                                <td colspan="@(2 + matrix.BotPlayerIds.Count)" class="py-2 px-4"
                                    style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.2em; color:#ffb3ac; text-transform:uppercase; border-bottom:1px solid rgba(64,73,67,0.5);">
                                    Weapons
                                </td>
                            </tr>
                            @foreach (var row in matrix.WeaponRows)
                            {
                                <tr class="transition-colors" style="border-bottom:1px solid rgba(64,73,67,0.2); @RowBg(row.RowStatus)"
                                    onmouseover="this.style.background='rgba(32,32,31,1)'" onmouseout="this.style.background=''">
                                    <td class="py-3 px-4" style="font-family:Manrope,sans-serif; font-size:16px; color:#e5e2e1; border-right:1px solid rgba(64,73,67,0.3);">
                                        <strong>@row.CardName</strong>
                                    </td>
                                    <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                        @if (row.RowStatus == "in_hand")
                                        {
                                            <span class="text-xs font-bold uppercase tracking-widest" style="color:#9cd2b5; font-family:Manrope,sans-serif;">MY CARD</span>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleCardStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <div class="cell-pill" data-status="@row.RowStatus">
                                                    <select name="status" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                                        <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">Maybe</option>
                                                        <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">Seen</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        }
                                    </td>
                                    @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                                    {
                                        var botId = matrix.BotPlayerIds[bi];
                                        var cell  = row.BotCells.ElementAtOrDefault(bi);
                                        var cs    = cell?.CellStatus ?? "normal";
                                        <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                            <form asp-action="ToggleCellStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <input type="hidden" name="botPlayerId" value="@botId" />
                                                <div class="cell-pill" data-status="@cs">
                                                    @if (!string.IsNullOrEmpty(CellIcon(cs)))
                                                    {
                                                        <span class="material-symbols-outlined pill-icon" style="color:@CellColor(cs);">@CellIcon(cs)</span>
                                                    }
                                                    <select name="cellStatus" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                                        <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">Has</option>
                                                        <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">No</option>
                                                        <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">~Has</option>
                                                        <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">~No</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }

                            @* Locations *@
                            <tr style="background:rgba(175,141,17,0.1);">
                                <td colspan="@(2 + matrix.BotPlayerIds.Count)" class="py-2 px-4"
                                    style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.2em; color:#e9c349; text-transform:uppercase; border-bottom:1px solid rgba(64,73,67,0.5);">
                                    Locations
                                </td>
                            </tr>
                            @foreach (var row in matrix.LocationRows)
                            {
                                <tr class="transition-colors" style="border-bottom:1px solid rgba(64,73,67,0.2); @RowBg(row.RowStatus)"
                                    onmouseover="this.style.background='rgba(32,32,31,1)'" onmouseout="this.style.background=''">
                                    <td class="py-3 px-4" style="font-family:Manrope,sans-serif; font-size:16px; color:#e5e2e1; border-right:1px solid rgba(64,73,67,0.3);">
                                        <strong>@row.CardName</strong>
                                    </td>
                                    <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                        @if (row.RowStatus == "in_hand")
                                        {
                                            <span class="text-xs font-bold uppercase tracking-widest" style="color:#9cd2b5; font-family:Manrope,sans-serif;">MY CARD</span>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleCardStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <div class="cell-pill" data-status="@row.RowStatus">
                                                    <select name="status" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                                        <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">Maybe</option>
                                                        <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">Seen</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        }
                                    </td>
                                    @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                                    {
                                        var botId = matrix.BotPlayerIds[bi];
                                        var cell  = row.BotCells.ElementAtOrDefault(bi);
                                        var cs    = cell?.CellStatus ?? "normal";
                                        <td class="text-center px-2" style="border-right:1px solid rgba(64,73,67,0.1); min-width:80px;">
                                            <form asp-action="ToggleCellStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="gameId" value="@matrix.GameId" />
                                                <input type="hidden" name="cardId" value="@row.CardId" />
                                                <input type="hidden" name="botPlayerId" value="@botId" />
                                                <div class="cell-pill" data-status="@cs">
                                                    @if (!string.IsNullOrEmpty(CellIcon(cs)))
                                                    {
                                                        <span class="material-symbols-outlined pill-icon" style="color:@CellColor(cs);">@CellIcon(cs)</span>
                                                    }
                                                    <select name="cellStatus" onchange="cellChanged(this)" class="cell-select">
                                                        <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                                        <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">Has</option>
                                                        <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">No</option>
                                                        <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">~Has</option>
                                                        <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">~No</option>
                                                    </select>
                                                    <span class="material-symbols-outlined pill-chevron">expand_more</span>
                                                </div>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
            </div>

            @* ── Footer widgets ── *@
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="p-5 shadow-lg" style="background:#2a2a2a; border:1px solid rgba(64,73,67,0.3);">
                    <h3 class="uppercase mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#9cd2b5; letter-spacing:0.1em;">Latest Clue</h3>
                    @if (Model.LastSuggestionResult is { } lsr)
                    {
                        <p class="italic" style="font-family:Manrope,sans-serif; font-size:16px; color:#c0c9c1; line-height:1.6;">
                            "@lsr.CharacterName suggested with @lsr.WeaponName at @lsr.LocationName."
                        </p>
                    }
                    else
                    {
                        <p class="italic" style="font-family:Manrope,sans-serif; font-size:16px; color:#c0c9c1;">No suggestion yet this round.</p>
                    }
                </div>
                <div class="p-5 shadow-lg" style="background:#2a2a2a; border:1px solid rgba(64,73,67,0.3);">
                    <h3 class="uppercase mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#9cd2b5; letter-spacing:0.1em;">Players</h3>
                    <div class="flex flex-col gap-1">
                        @foreach (var p in game.Players)
                        {
                            <p style="font-family:Manrope,sans-serif; font-size:14px; color:#c0c9c1;">
                                @p.Name <span style="color:#8a938c;">(@(p.IsBot ? "bot" : "you"))</span>
                            </p>
                        }
                    </div>
                </div>
                <div class="p-5 shadow-lg" style="background:#2a2a2a; border:1px solid rgba(64,73,67,0.3);">
                    <h3 class="uppercase mb-3" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#9cd2b5; letter-spacing:0.1em;">Current Phase</h3>
                    <p class="font-bold uppercase mb-3" style="font-family:'Noto Serif',serif; font-size:18px; color:#e9c349;">
                        @game.TurnPhase.Replace("_", " ")
                    </p>
                    @if (isHumanTurn)
                    {
                        <p class="italic text-sm" style="font-family:Manrope,sans-serif; color:#c0c9c1;">Make a suggestion below.</p>
                    }
                </div>
            </div>

            @* ── Suggestion form ── *@
            @if (isHumanTurn)
            {
                <div class="p-6 mb-8" style="background:#1c1b1b; border:1px solid rgba(156,210,181,0.3);">
                    <h3 class="uppercase mb-6" style="font-family:'Noto Serif',serif; font-size:24px; font-weight:600; color:#9cd2b5;">Make a Suggestion</h3>
                    <form asp-action="Suggest" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="GameId" value="@game.Id" />
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                            <div class="space-y-2">
                                <label class="flex items-center gap-2 uppercase tracking-widest"
                                       style="font-family:Manrope,sans-serif; font-size:11px; font-weight:600; color:#8a938c; letter-spacing:0.12em;">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:#9cd2b5;">person</span>
                                    Suspect
                                </label>
                                <div class="select-field-wrap">
                                    <select name="CharacterId" class="select-field">
                                        @foreach (var c in Model.Characters)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined select-field-icon">expand_more</span>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="flex items-center gap-2 uppercase tracking-widest"
                                       style="font-family:Manrope,sans-serif; font-size:11px; font-weight:600; color:#8a938c; letter-spacing:0.12em;">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:#9cd2b5;">hardware</span>
                                    Weapon
                                </label>
                                <div class="select-field-wrap">
                                    <select name="WeaponId" class="select-field">
                                        @foreach (var w in Model.Weapons)
                                        {
                                            <option value="@w.Id">@w.Name</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined select-field-icon">expand_more</span>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="flex items-center gap-2 uppercase tracking-widest"
                                       style="font-family:Manrope,sans-serif; font-size:11px; font-weight:600; color:#8a938c; letter-spacing:0.12em;">
                                    <span class="material-symbols-outlined" style="font-size:14px; color:#9cd2b5;">location_on</span>
                                    Location
                                </label>
                                <div class="select-field-wrap">
                                    <select name="LocationId" class="select-field">
                                        @foreach (var l in Model.Locations)
                                        {
                                            <option value="@l.Id">@l.Name</option>
                                        }
                                    </select>
                                    <span class="material-symbols-outlined select-field-icon">expand_more</span>
                                </div>
                            </div>
                        </div>
                        <button type="submit"
                                class="flex items-center gap-2 px-8 py-3 font-bold uppercase tracking-widest transition-all active:scale-95"
                                style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.4); font-family:'Noto Serif',serif; font-size:18px; border-radius:0.125rem; cursor:pointer;"
                                onmouseover="this.style.background='rgba(6,64,43,0.8)';"
                                onmouseout="this.style.background='#06402b';">
                            <span class="material-symbols-outlined" style="font-size:20px;">search</span>
                            Submit Suggestion
                        </button>
                    </form>
                </div>
            }

        </div>
    </main>

</div>

@section Scripts {
<script>
    function cellChanged(sel) {
        sel.closest('.cell-pill').dataset.status = sel.value;
        sel.form.submit();
    }
</script>
}
