@model clueGame.Models.ViewModels.GameOverViewModel
@{
    ViewData["Title"] = Model.Won ? "Case Closed" : "Game Over";
    var won = Model.Won;
}

<div style="background:#131313; min-height:calc(100vh - 64px - 100px); display:flex; align-items:center; justify-content:center; padding:48px 24px;">
    <div class="max-w-2xl w-full mx-auto text-center">

        <!-- Icon -->
        <div class="mx-auto mb-6 w-20 h-20 rounded-full flex items-center justify-center"
             style="background:@(won ? "rgba(6,64,43,0.3)" : "rgba(147,0,10,0.2)"); border:2px solid @(won ? "rgba(156,210,181,0.5)" : "rgba(255,180,171,0.5)"); box-shadow:0 0 30px @(won ? "rgba(156,210,181,0.15)" : "rgba(255,180,171,0.1)");">
            <span class="material-symbols-outlined" style="font-size:40px; color:@(won ? "#9cd2b5" : "#ffb4ab"); font-variation-settings:'FILL' 1;">
                @(won ? "check_circle" : "cancel")
            </span>
        </div>

        <!-- Headline -->
        <h1 style="font-family:'Noto Serif',serif; font-size:clamp(36px,8vw,64px); font-weight:700; letter-spacing:-0.02em; line-height:1.1; margin-bottom:16px; color:@(won ? "#e9c349" : "#ffb4ab");">
            @(won ? "CASE CLOSED" : "GAME OVER")
        </h1>

        <p class="italic mb-10" style="font-family:Manrope,sans-serif; font-size:18px; color:#c0c9c1; line-height:1.6;">
            @(won
                ? "Your accusation was correct. Justice has been served in Blackwood Estate."
                : "Your accusation was wrong. The truth remains buried in the mansion's shadows.")
        </p>

        <!-- Solution reveal -->
        <div class="mb-10 p-6" style="background:#1c1b1b; border:1px solid #404943; box-shadow:0 8px 24px rgba(0,0,0,0.5);">
            <p class="uppercase tracking-[0.3em] mb-6" style="font-family:Manrope,sans-serif; font-size:12px; font-weight:600; color:#8a938c;">
                The Solution Was
            </p>
            <div class="grid grid-cols-3 gap-4">

                <div class="p-4 rounded" style="background:#20201f; border:1px solid rgba(156,210,181,0.2);">
                    <span class="material-symbols-outlined mb-2 block" style="font-size:28px; color:#9cd2b5;">person</span>
                    <p class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:10px; color:#8a938c;">Suspect</p>
                    <p class="font-bold" style="font-family:'Noto Serif',serif; font-size:16px; color:#e5e2e1;">@Model.SecretCharacterName</p>
                </div>

                <div class="p-4 rounded" style="background:#20201f; border:1px solid rgba(255,180,171,0.2);">
                    <span class="material-symbols-outlined mb-2 block" style="font-size:28px; color:#ffb3ac;">hardware</span>
                    <p class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:10px; color:#8a938c;">Weapon</p>
                    <p class="font-bold" style="font-family:'Noto Serif',serif; font-size:16px; color:#e5e2e1;">@Model.SecretWeaponName</p>
                </div>

                <div class="p-4 rounded" style="background:#20201f; border:1px solid rgba(233,195,73,0.2);">
                    <span class="material-symbols-outlined mb-2 block" style="font-size:28px; color:#e9c349;">meeting_room</span>
                    <p class="uppercase tracking-widest mb-1" style="font-family:Manrope,sans-serif; font-size:10px; color:#8a938c;">Location</p>
                    <p class="font-bold" style="font-family:'Noto Serif',serif; font-size:16px; color:#e5e2e1;">@Model.SecretLocationName</p>
                </div>

            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-center gap-4 flex-wrap">
            <a asp-action="New"
               class="flex items-center gap-3 px-10 py-4 font-bold uppercase tracking-widest transition-all active:scale-95"
               style="background:#06402b; color:#e9c349; border:1px solid rgba(233,195,73,0.4); font-family:'Noto Serif',serif; font-size:18px; border-radius:0.125rem; box-shadow:0 0 20px rgba(6,64,43,0.3); text-decoration:none;"
               onmouseover="this.style.background='rgba(6,64,43,0.8)'"
               onmouseout="this.style.background='#06402b'">
                <span class="material-symbols-outlined" style="font-size:20px;">refresh</span>
                Play Again
            </a>
            <a asp-controller="Home" asp-action="Dashboard"
               style="font-family:Manrope,sans-serif; font-size:14px; color:#8a938c; text-decoration:none; padding:16px;"
               onmouseover="this.style.color='#c0c9c1'" onmouseout="this.style.color='#8a938c'">
                View Dashboard →
            </a>
        </div>

    </div>
</div>
