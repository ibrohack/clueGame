@model clueGame.Models.ViewModels.BoardViewModel
@{
    ViewData["Title"] = "Game Board";
    var game = Model.Game;
    var human = Model.HumanPlayer;
    var isHumanTurn = game.TurnPhase == "human_suggestion";
    var isHumanDone = game.TurnPhase == "human_done";
    var isBotTurns = game.TurnPhase == "bot_turns";

    var matrix = Model.BuildMatrix();

    string RowCss(string s) => s switch
    {
        "in_hand"   => "background:#c8e6c9",
        "discarded" => "background:#e0e0e0",
        "suspect"   => "background:#fff9c4",
        _           => ""
    };

    string CellCss(string s) => s switch
    {
        "has_it"      => "background:#a5d6a7",
        "no_has_it"   => "background:#ef9a9a",
        "suspect_has" => "background:#c8e6c9;opacity:.8",
        "suspect_no"  => "background:#ffcdd2;opacity:.8",
        _             => ""
    };
}

<h2>Game Board</h2>

<p>
    <strong>Your character:</strong>
    @Model.Characters.FirstOrDefault(c => c.Id == human.CharacterId)?.Name
    &nbsp;|&nbsp;
    <strong>Phase:</strong> @game.TurnPhase
    &nbsp;|&nbsp;
    <strong>Players:</strong> @string.Join(", ", game.Players.Select(p => p.Name + (p.IsBot ? " (bot)" : " (you)")))
</p>

@* ── Suggestion result ── *@
@if (Model.LastSuggestionResult is { } sr)
{
    <div style="border:1px solid #999;padding:8px;margin-bottom:12px">
        <strong>Your suggestion:</strong>
        @sr.CharacterName + @sr.WeaponName + @sr.LocationName
        <br />
        @if (sr.NoOneRefuted)
        {
            <span>Nobody could refute your suggestion.</span>
        }
        else
        {
            <span><strong>@sr.RefutedByName</strong> showed you: <strong>@sr.ShownCardName</strong></span>
        }
    </div>
}

@* ── Bot turn summary ── *@
@if (Model.CurrentBotTurn is { } bt)
{
    <div style="border:1px solid #aaa;padding:8px;margin-bottom:12px">
        <strong>@bt.BotName's turn:</strong>
        @if (!string.IsNullOrEmpty(bt.CharacterName))
        {
            <span>Suggested @bt.CharacterName + @bt.WeaponName at @bt.LocationName.</span>
        }
        <br />
        @if (bt.NoOneRefuted)
        {
            <span>Nobody refuted.</span>
        }
        else
        {
            <span>Refuted by <strong>@bt.RefutedByName</strong>.</span>
            @if (!string.IsNullOrEmpty(bt.ShownCardName))
            {
                <span> Showed: <strong>@bt.ShownCardName</strong>.</span>
            }
        }
    </div>
}

@* ── Action panel ── *@
<div style="margin-bottom:16px">
    @if (isHumanTurn)
    {
        <a asp-action="Accuse" asp-route-gameId="@game.Id">Make Accusation</a>
        <text> | </text>
        <a href="#suggest-form">Make Suggestion ↓</a>
    }

    @if (isHumanDone)
    {
        <form asp-action="EndTurn" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="gameId" value="@game.Id" />
            <button type="submit">End Turn (start bot turns)</button>
        </form>
    }

    @if (isBotTurns)
    {
        <form asp-action="NextBot" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="gameId" value="@game.Id" />
            <input type="hidden" name="botIndex" value="@game.PendingBotIndex" />
            <button type="submit">Next Bot Turn →</button>
        </form>
    }

    &nbsp;|&nbsp;
    <form asp-action="Abandon" method="post" style="display:inline"
          onsubmit="return confirm('Abandon this game?')">
        @Html.AntiForgeryToken()
        <input type="hidden" name="gameId" value="@game.Id" />
        <button type="submit">Abandon Game</button>
    </form>
</div>

@* ── Detective Sheet Matrix ── *@
<h3>Detective Sheet</h3>

<table border="1" cellpadding="0"
       style="border-collapse:collapse;margin-bottom:24px;table-layout:fixed">
    <colgroup>
        <col style="width:150px" />
        <col style="width:90px" />
        @foreach (var _ in matrix.BotNames)
        {
            <col style="width:80px" />
        }
    </colgroup>
    <thead>
        <tr style="background:#f5f5f5">
            <th style="padding:4px 6px">Card</th>
            <th style="padding:4px 6px">Me</th>
            @foreach (var botName in matrix.BotNames)
            {
                <th style="padding:4px 6px;font-size:.85rem">@botName</th>
            }
        </tr>
    </thead>
    <tbody>

        @* ── Suspects ── *@
        <tr style="background:#ddd">
            <th colspan="@(2 + matrix.BotPlayerIds.Count)" style="text-align:left;padding:4px 6px">Suspects</th>
        </tr>
        @foreach (var row in matrix.CharacterRows)
        {
            <tr style="@RowCss(row.RowStatus)">
                <td style="padding:4px 6px;white-space:nowrap"><strong>@row.CardName</strong></td>
                <td style="text-align:center;min-width:90px;padding:2px">
                    @if (row.RowStatus == "in_hand")
                    {
                        <span style="font-weight:bold">MY CARD</span>
                    }
                    else
                    {
                        <form asp-action="ToggleCardStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <select name="status" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">?</option>
                                <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">SEEN</option>
                            </select>
                        </form>
                    }
                </td>
                @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                {
                    var botId = matrix.BotPlayerIds[bi];
                    var cell = row.BotCells.ElementAtOrDefault(bi);
                    var cs = cell?.CellStatus ?? "normal";
                    <td style="text-align:center;min-width:75px;padding:2px;@CellCss(cs)">
                        <form asp-action="ToggleCellStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <input type="hidden" name="botPlayerId" value="@botId" />
                            <select name="cellStatus" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">HAS</option>
                                <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">NO</option>
                                <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">?HAS</option>
                                <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">?NO</option>
                            </select>
                        </form>
                    </td>
                }
            </tr>
        }

        @* ── Weapons ── *@
        <tr style="background:#ddd">
            <th colspan="@(2 + matrix.BotPlayerIds.Count)" style="text-align:left;padding:4px 6px">Weapons</th>
        </tr>
        @foreach (var row in matrix.WeaponRows)
        {
            <tr style="@RowCss(row.RowStatus)">
                <td style="padding:4px 6px;white-space:nowrap"><strong>@row.CardName</strong></td>
                <td style="text-align:center;min-width:90px;padding:2px">
                    @if (row.RowStatus == "in_hand")
                    {
                        <span style="font-weight:bold">MY CARD</span>
                    }
                    else
                    {
                        <form asp-action="ToggleCardStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <select name="status" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">?</option>
                                <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">SEEN</option>
                            </select>
                        </form>
                    }
                </td>
                @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                {
                    var botId = matrix.BotPlayerIds[bi];
                    var cell = row.BotCells.ElementAtOrDefault(bi);
                    var cs = cell?.CellStatus ?? "normal";
                    <td style="text-align:center;min-width:75px;padding:2px;@CellCss(cs)">
                        <form asp-action="ToggleCellStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <input type="hidden" name="botPlayerId" value="@botId" />
                            <select name="cellStatus" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">HAS</option>
                                <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">NO</option>
                                <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">?HAS</option>
                                <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">?NO</option>
                            </select>
                        </form>
                    </td>
                }
            </tr>
        }

        @* ── Locations ── *@
        <tr style="background:#ddd">
            <th colspan="@(2 + matrix.BotPlayerIds.Count)" style="text-align:left;padding:4px 6px">Locations</th>
        </tr>
        @foreach (var row in matrix.LocationRows)
        {
            <tr style="@RowCss(row.RowStatus)">
                <td style="padding:4px 6px;white-space:nowrap"><strong>@row.CardName</strong></td>
                <td style="text-align:center;min-width:90px;padding:2px">
                    @if (row.RowStatus == "in_hand")
                    {
                        <span style="font-weight:bold">MY CARD</span>
                    }
                    else
                    {
                        <form asp-action="ToggleCardStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <select name="status" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"    selected="@(row.RowStatus == "normal"    ? "selected" : null)">—</option>
                                <option value="suspect"   selected="@(row.RowStatus == "suspect"   ? "selected" : null)">?</option>
                                <option value="discarded" selected="@(row.RowStatus == "discarded" ? "selected" : null)">SEEN</option>
                            </select>
                        </form>
                    }
                </td>
                @for (int bi = 0; bi < matrix.BotPlayerIds.Count; bi++)
                {
                    var botId = matrix.BotPlayerIds[bi];
                    var cell = row.BotCells.ElementAtOrDefault(bi);
                    var cs = cell?.CellStatus ?? "normal";
                    <td style="text-align:center;min-width:75px;padding:2px;@CellCss(cs)">
                        <form asp-action="ToggleCellStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="gameId" value="@matrix.GameId" />
                            <input type="hidden" name="cardId" value="@row.CardId" />
                            <input type="hidden" name="botPlayerId" value="@botId" />
                            <select name="cellStatus" onchange="this.form.submit()" style="width:100%">
                                <option value="normal"      selected="@(cs == "normal"      ? "selected" : null)">—</option>
                                <option value="has_it"      selected="@(cs == "has_it"      ? "selected" : null)">HAS</option>
                                <option value="no_has_it"   selected="@(cs == "no_has_it"   ? "selected" : null)">NO</option>
                                <option value="suspect_has" selected="@(cs == "suspect_has" ? "selected" : null)">?HAS</option>
                                <option value="suspect_no"  selected="@(cs == "suspect_no"  ? "selected" : null)">?NO</option>
                            </select>
                        </form>
                    </td>
                }
            </tr>
        }

    </tbody>
</table>

@* ── Suggestion form ── *@
@if (isHumanTurn)
{
    <h3 id="suggest-form">Make a Suggestion</h3>
    <form asp-action="Suggest" method="post" style="max-width:400px">
        @Html.AntiForgeryToken()
        <input type="hidden" name="GameId" value="@game.Id" />

        <div>
            <label>Suspect</label>
            <select name="CharacterId">
                @foreach (var c in Model.Characters)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Weapon</label>
            <select name="WeaponId">
                @foreach (var w in Model.Weapons)
                {
                    <option value="@w.Id">@w.Name</option>
                }
            </select>
        </div>
        <div>
            <label>Location</label>
            <select name="LocationId">
                @foreach (var l in Model.Locations)
                {
                    <option value="@l.Id">@l.Name</option>
                }
            </select>
        </div>
        <br />
        <button type="submit">Submit Suggestion</button>
    </form>
}
